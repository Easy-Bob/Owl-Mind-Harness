# Copy to .env and fill in. Never commit .env.
# These two values match the local services in docker-compose.yml.
DATABASE_URL=postgresql://owl:owl_dev@localhost:5433/owl
REDIS_URL=redis://localhost:6380/0
# Needed only when a live model is requested.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Off while the large tier uses the same model as layer 2.
INTENT_LAYER3_ENABLED=false
