# Copy to .env and fill in. Never commit .env.
# These two values match the local services in docker-compose.yml.
DATABASE_URL=postgresql://owl:owl_dev@localhost:5433/owl
REDIS_URL=redis://localhost:6380/0
# Needed only when a live model is requested.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Off while the large tier uses the same model as layer 2.
INTENT_LAYER3_ENABLED=false
# Stays off until M3-E delivers token budgets.
LIVE_AGENT_RUNS_ENABLED=false
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Keep true anywhere but local development, because cookies then need HTTPS.
COOKIE_SECURE=false
# Comma-separated. Listed emails are admins, and signup can never grant this.
CONFIGURED_ADMINS=
# Comma-separated. With none, nobody can sign up.
INVITE_CODES=
# Course material imports. The model downloads to the cache folder on first use.
MAX_UPLOAD_MB=25
INGEST_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=
# Forum handoff: a private GitHub repository with Discussions, reached through a GitHub App.
FORUM_REPO=
FORUM_CATEGORY=Q&A
FORUM_APP_ID=
# Keep the key outside the project, so it can never be committed.
FORUM_APP_PRIVATE_KEY_PATH=
